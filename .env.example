# Copy to .env.local and fill in once you own a domain.
NEXT_PUBLIC_SITE_NAME=ClashLayouts
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_IMAGE_WATERMARK=YourDomain.com

# Google AdSense publisher ID (the "ca-pub-..." value from your AdSense
# verification snippet, from adsense.google.com). Leave unset until you have
# one — the loader script (app/layout.tsx) and ads.txt (app/ads.txt) both
# stay inert without it, so nothing breaks in local dev or before approval.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Ratings/views storage (Upstash Redis over its HTTP/REST API — not a
# traditional database to provision or manage, just a free account and two
# keys). Get these from a free database at https://upstash.com, or by adding
# the Upstash integration from your Vercel project's Storage tab (which
# injects both vars automatically). Leave both unset for local dev — the
# site falls back to a non-persistent in-memory store with zero setup.
# See lib/ratings-store.ts for details.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
