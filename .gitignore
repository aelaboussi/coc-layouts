# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed) — .env.example is the
# template and stays tracked so the repo documents which vars exist
.env*
!.env.example

# vercel
.vercel

# runtime rating/view data (see lib/ratings-store.ts) — regenerated per
# deployment, not part of the source dataset
/data/ratings.json

# typescript
*.tsbuildinfo
next-env.d.ts
